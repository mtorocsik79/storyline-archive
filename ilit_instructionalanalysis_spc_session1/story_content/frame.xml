_player.5lordmHOkVN.6q2Ou9Y1EpN" displaytext="Explicit Teaching and Modeling" expand="true" /><slidelink slideid="_player.5lordmHOkVN.5nDCbPP885g" displaytext="Ongoing Formative Assessment" expand="true" /><slidelink slideid="_player.5lordmHOkVN.6QgdiEh8q1t" displaytext="Engagement and Motivation" expand="true" /><slidelink slideid="_player.5lordmHOkVN.5yOqlnCn1FL" displaytext="Pause and Reflect" expand="true" /><slidelink slideid="_player.5lordmHOkVN.6rAazeorr3a" displaytext="Modeling of Comprehension Strategies " expand="true" /><slidelink slideid="_player.5lordmHOkVN.6Iq1Zv0l0dB" displaytext="Workshop Model" expand="true" /><slidelink slideid="_player.5lordmHOkVN.5dRxKWCfRht" displaytext="Gradual Release Model" expand="true" /><slidelink slideid="_player.5lordmHOkVN.5mtVQiN2RG6" displaytext="Ramp-Up Results" expand="true" /></links></slidelink><slidelink slideid="_player.5lordmHOkVN.5jEwChQc1r2" displaytext="Quick Check" expand="true" /></links></slidelink><slidelink slideid="_player.5sAy3G6lSph" displaytext="In Practice" expand="false"><links><slidelink slideid="_player.5sAy3G6lSph.6nquRLsLcZB" displaytext="Ramp Up Literacy: Effective Strategies Video" expand="true" /><slidelink slideid="_player.5sAy3G6lSph.6H7IWnoZ7M5" displaytext="Video: Effective Strategies" expand="true" /><slidelink slideid="_player.5sAy3G6lSph.62M60Ely3Z5" displaytext="Video Reflection" expand="true" /></links></slidelink><slidelink slideid="_player.5jiX1T51hg4" displaytext="Apply" expand="false"><links><slidelink slideid="_player.5jiX1T51hg4.6iKBr93cQpV" displaytext="In the Classroom" expand="true" /><slidelink slideid="_player.5jiX1T51hg4.6J8ejJNglRH" displaytext="Assignment" expand="true" /><slidelink slideid="_player.5jiX1T51hg4.5aGHLHZszK7" displaytext="Discussion Board" expand="true" /></links></slidelink><slidelink slideid="_player.5qkHyZOloOG.5sfrbPJRpdc" displaytext="Review" expand="true" /><slidelink slideid="_player.6UEs7OZ5UK0.6IPRuPbOAEH" displaytext="Prepare for the Next Session" expand="true" /><slidelink slideid="_player.6g0DTVhO1iq.5ffjRyHS0MQ" displaytext="Assessment" expand="true" /><slidelink slideid="_player.5f8BevrTsUl.5yxmodna7P4" displaytext="Participant Workbook" expand="true" /></links></outline></nav_data><resource_data description="" /><transcript_data><slidetranscripts><slidetranscript slideid="6K0PqHBo3rl.6qgwMGO1rVi" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;Welcome to The Research Base behind iLit™, the first session of the iLit™ 2012 Instructional Analysis Online Course. This session should take you approximately 75 minutes to complete. &lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;You’ll need your Participant Workbook for this session. Go ahead and pause the video while you get this resource. Click Play when you’re ready to continue.&lt;/font&gt;&lt;font face='Articulate' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="6K0PqHBo3rl.6WC6lyvn5GX" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;Before we begin, let’s review the course outcomes.&lt;/font&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="6K0PqHBo3rl.5bTiOgdYcwA" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;Now, let’s look at the Session 1 objectives.&lt;br&gt;&lt;br&gt;By the end of this session you will be able to&lt;br&gt;&lt;br&gt;- understand and explain the research behind iLit™ and &lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;- review and analyze Ramp Up research&lt;/font&gt;&lt;font face='Articulate' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="6K0PqHBo3rl.6Ab7H5N5XYZ" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;Spend a moment thinking about why your district has chosen to use iLit™ as its literacy program. &lt;br&gt;&lt;br&gt;Now, let’s watch a video clip that explains why one school district chose to use Ramp-Up Literacy® as their literacy program. Click Play to start the video.&lt;br&gt;&lt;br&gt;iLit™ is based on the instructional model of Ramp Up. Are some of the reasons in the video the same as the ones you identified? &lt;br&gt;&lt;br&gt;A program with a strong research base behind it is more likely to positively affect student growth.&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;Okay, let’s discuss the research base behind iLit™.&lt;/font&gt;&lt;font face='Articulate' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="6K0PqHBo3rl.6Ns6E3gPH8E" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;Spend a moment thinking about why your district has chosen to use iLit™ as its literacy program. &lt;br&gt;&lt;br&gt;Now, let’s watch a video clip that explains why one school district chose to use Ramp-Up Literacy® as their literacy program. Click Play to start the video.&lt;br&gt;&lt;br&gt;iLit™ is based on the instructional model of Ramp Up. Are some of the reasons in the video the same as the ones you identified? &lt;br&gt;&lt;br&gt;A program with a strong research base behind it is more likely to positively affect student growth.&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;Okay, let’s discuss the research base behind iLit™.&lt;/font&gt;&lt;font face='Articulate' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="5lordmHOkVN.5XhoDbFxI9z" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;iLit™ is based upon the instructional model of Ramp-Up Literacy®, a program for striving readers.&lt;br&gt;&lt;br&gt;As we heard in the video clip, Ramp-Up Literacy® has been proven to consistently improve students’ reading levels.&lt;br&gt;&lt;br&gt;Now, let’s take a look at the components included in Ramp-Up’s instructional model.&lt;/font&gt;&lt;font face='Articulate' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="5lordmHOkVN.6q2Ou9Y1EpN" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;Teacher modeling allows students to see a proficient reader in action. It provides students with examples of how they can think about and understand texts. Modeling and explicit teaching also give students strategies for working through difficulties they encounter in the text. &lt;/font&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="5lordmHOkVN.5nDCbPP885g" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;Formative assessments occur while the learning is happening, rather than at the end of the unit or chapter. This allows teachers to use the results from the assessments to differentiate instruction so each student gets the instruction that he or she needs. Formative assessments are also used to create learning goals for students. When instruction is based on students’ formative assessment results, it can be tailored to individual students, which leads to student success.&lt;/font&gt;&lt;font face='Articulate' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="5lordmHOkVN.6QgdiEh8q1t" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;Providing students with appealing and diverse materials and allowing for student choice leads to increased engagement and motivation. &lt;/font&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="5lordmHOkVN.5yOqlnCn1FL" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;It’s time to Pause and Reflect! Before continuing, please respond to the Session 1 Pause and Reflect question in the Participant Workbook.&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;When you’re ready to move on, click &lt;b&gt;Next.&lt;/b&gt;&lt;/font&gt;&lt;font face='Articulate' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="5lordmHOkVN.6rAazeorr3a" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;There are several outcomes that are achieved through the modeling of comprehension strategies.  Modeling provides students with a glimpse into the metacognitive strategies used by proficient readers.  Modeling also provides students with a chance to mimic the processes of the teacher and attempt to implement the strategies on their own&lt;/font&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="5lordmHOkVN.6Iq1Zv0l0dB" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;The workshop model allows students to receive individualized instruction through teacher-led small-group work and conferring. It also provides students time to work together to use academic language and to practice the strategies and processes being modeled. &lt;/font&gt;&lt;font face='Articulate' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="5lordmHOkVN.5dRxKWCfRht" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;The gradual release model is the theory upon which Ramp-Up Literacy® and iLit™ are based. The gradual release of responsibility model consists of several cyclical components. The model moves from high teacher support and responsibility to low teacher support and responsibility. The components of the gradual release model include direct instruction, guided instruction, guided practice, and independent practice. &lt;/font&gt;&lt;font face='Articulate' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="5lordmHOkVN.5mtVQiN2RG6" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;In a number of studies across demographically diverse school districts, students enrolled in a Ramp-Up Literacy®&lt;i&gt; &lt;/i&gt;course or receiving Ramp-Up Literacy®&lt;i&gt; &lt;/i&gt;instruction consistently showed gains on assessments and increased learning at a greater rate than national norms at respective grade levels. &lt;br&gt;&lt;br&gt;Varying research designs yielded similar positive results. In study after study, whether Ramp-Up&lt;i&gt; &lt;/i&gt;Literacy® students were compared to similarly abled control groups, to on-grade-level reading control groups, or as a single group pre-/post test, the Ramp- Up&lt;i&gt; &lt;/i&gt;Literacy®&lt;i&gt; &lt;/i&gt;instructional treatment yielded significant gains beyond expectations.&lt;br&gt;&lt;br&gt;In many cases, the results proved gains of two or more grade levels in a single year of instruction.&lt;/font&gt;&lt;font face='Articulate' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="5lordmHOkVN.5jEwChQc1r2" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;To review the content covered in this Learn section, take a few moments to respond to the Session 1 Quick Check questions.  &lt;/font&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="5sAy3G6lSph.6nquRLsLcZB" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;Now you’ll watch an interview with a Ramp- Up Literacy® teacher explaining the effective strategies embedded into the program. &lt;br&gt;&lt;br&gt;Click Play to start the video.&lt;br&gt;&lt;br&gt;Once you have watched the video, you will respond to reflection questions in your Participant Workbook.&lt;/font&gt;&lt;font face='Articulate' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="5sAy3G6lSph.62M60Ely3Z5" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;Once you have watched the video, respond to the following video reflection questions in your Participant Workbook. &lt;br&gt;&lt;br&gt;What aspects of the instructional model does the teacher reference in this video?&lt;br&gt;&lt;br&gt;Why are these aspects effective in increasing student achievement?&lt;/font&gt;&lt;font face='Articulate' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="5jiX1T51hg4.6iKBr93cQpV" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;Let’s zoom in on Ramp-Up results. Exploring data from the Ramp-Up Literacy® program will help solidify our understanding of the effectiveness of the instructional model and research base upon which iLit™ is built. Let’s listen in as two teachers discuss the data. The teachers will be discussing the following questions:&lt;br&gt;·What does the graph show? and&lt;br&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;·How did Ramp-Up Literacy® instruction affect student growth?&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;&lt;b&gt;New Narrator 1:&lt;br&gt;&lt;/b&gt;It looks like this graph shows post-test results for sixth and ninth graders after Ramp-Up Literacy® instruction.&lt;br&gt;&lt;br&gt;&lt;b&gt;New Narrator 2:&lt;br&gt;&lt;/b&gt;Yes, I agree. It also states in the footnote that the NCE score is supposed to stay the same from year to year. So it is unexpected that there is an increase in this type of score.&lt;br&gt;&lt;br&gt;&lt;b&gt;New Narrator 1:&lt;/b&gt;&lt;br&gt;It looks like the sixth graders made a seven-point gain after receiving Ramp-Up instruction. Wow! That is amazing, considering the scores are expected to remain unchanged!&lt;br&gt;&lt;br&gt;&lt;b&gt;New Narrator 2:&lt;br&gt;&lt;/b&gt;I know! And the ninth graders made a four-point increase in their scores. According to the footnote, an increase in scores like the ones the students’ made indicates over a year’s worth of growth.&lt;br&gt;&lt;br&gt;&lt;b&gt;New Narrator 1:&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;Based on this data, it appears that Ramp-Up Literacy® is highly effective.&lt;/font&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="5jiX1T51hg4.6J8ejJNglRH" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;Now you’ll have a chance to analyze Ramp-Up data on your own! Analyze the data and answer the focus questions. &lt;/font&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="5jiX1T51hg4.5aGHLHZszK7" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;It’s time to share your thoughts with your peers! Go to the Discussion Board and respond to the Session 1 Discussion Board questions as you reflect on the research base behind iLit™.&lt;/font&gt;&lt;font face='Articulate' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="5qkHyZOloOG.5sfrbPJRpdc" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;Let’s review what we learned in this session.&lt;br&gt;&lt;br&gt;We began by learning about the research base behind Ramp-Up-the proven literacy program that iLit™ is based upon.&lt;br&gt;&lt;br&gt;Then we learned about Ramp-Up’s results.&lt;br&gt;&lt;br&gt;Next, you watched an interview with a Ramp-Up Literacy® teacher who explained some of the effective strategies in the program.&lt;br&gt;&lt;br&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;Finally, we zoomed in on Ramp-Up data, and you analyzed some of the program’s results.&lt;/font&gt;&lt;font face='Articulate' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="6UEs7OZ5UK0.6IPRuPbOAEH" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;In the next session, you’ll learn how the instructional base and research behind the Ramp-Up Literacy® program connects to iLit™. Be sure to complete the following tasks before beginning Self-Paced Session 2.&lt;br&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Arial' size='11.64pt' color='#000000'&gt;&lt;br&gt;- Read classroom scenarios and identify the components of the Ramp-Up instructional model. The scenarios and directions are located in the Participant Workbook.&lt;br&gt;&lt;br&gt;- Respond to two Discussion Board posts from other participants.&lt;/font&gt;&lt;font face='Articulate' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript><slidetranscript slideid="6g0DTVhO1iq.5ffjRyHS0MQ" slidebank="false">&lt;html&gt;&lt;p align='left'&gt;&lt;textformat leading='1' tabstops='[48, 96]' leftmargin='0' indent='0'&gt;&lt;font face='Articulate' size='11.64pt' color='#000000'&gt;Now, show what you know! Visit the course homepage to take the assessment for Session 1. We’ll see you again in Session 2. &lt;/font&gt;&lt;font face='Articulate' size='11.64pt' color='#000000'&gt;&lt;/font&gt;&lt;/textformat&gt;&lt;/p&gt;&lt;/html&gt;</slidetranscript></slidetranscripts></transcript_data><glossary_data /></bwFrame>